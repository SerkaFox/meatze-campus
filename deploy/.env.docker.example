# ============================================================================
# MEATZE Campus — container environment (docker compose)
# Copy to deploy/.env and fill in. NEVER commit the filled-in file.
# ============================================================================

# ---- Docker deploy knobs ---------------------------------------------------
HTTP_PORT=8080          # host port for nginx (set to 80 on the target server)
WITH_CHROMIUM=0         # 1 = bake Chromium for docx->pdf preview (bigger image)

# ---- Django ----------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1        # add the target domain(s)
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# Cookie domain — MUST match the deployment domain (leading dot for subdomains).
# For plain localhost testing leave these EMPTY.
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=

# ---- Database (values also used to init the postgres container) ------------
DB_NAME=meatze_db
DB_USER=meatze_user
DB_PASSWORD=change-me
DB_HOST=db              # overridden to `db` by compose; keep as is
DB_PORT=5432

# ---- Admin panel -----------------------------------------------------------
MEATZE_ADMIN_PASS=

# ---- Email (Gmail SMTP) ----------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=MEATZE Admin <noreply@example.com>

# ---- WhatsApp Cloud API ----------------------------------------------------
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=
WA_ADMIN_BILBAO=
WA_ADMIN_BARAKALDO=

# ---- Google Drive picker ---------------------------------------------------
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_APP_ID=

# ---- Ollama (external AI host) ---------------------------------------------
# Point at the host running Ollama. From a container, 127.0.0.1 is the container
# itself — use host.docker.internal or the server's LAN IP.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- ComfyUI (external, optional image/video generation) -------------------
COMFY_BASE=http://host.docker.internal:8188
# COMFY_WORKFLOW_VIDEO=/path/workflow_video.json
# COMFY_WORKFLOW_IMAGE=/path/workflow_image.json

# ---- Jitsi (must match the deploy/jitsi stack / external Jitsi) ------------
JITSI_DOMAIN=meetjwt.meatzeaula.es
JITSI_JWT_ENABLED=1
JITSI_JWT_SECRET=meatze123
JITSI_JWT_APP_ID=meatze
JITSI_JWT_AUD=jitsi
