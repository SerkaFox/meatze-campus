# ============================================================================
# Aurora Jitsi stack — environment
# Based on docker-jitsi-meet. Copy to .env and fill in.
# ============================================================================

# Directory where per-service config is persisted on the host
CONFIG=~/.jitsi-meet-cfg

# Public URL (must be reachable over HTTPS by clients)
PUBLIC_URL=https://meetjwt.example.com

# Exposed ports (map to 80/443 behind your own TLS proxy, or use LetsEncrypt below)
HTTP_PORT=8443
HTTPS_PORT=8444

# The server's PUBLIC IP (clients connect to JVB here for media)
DOCKER_HOST_ADDRESS=203.0.113.10
JVB_ADVERTISE_IPS=203.0.113.10
JVB_PORT=10000
JVB_TCP_PORT=4443

# ---- TLS (LetsEncrypt inside the web container) ----------------------------
ENABLE_LETSENCRYPT=1
LETSENCRYPT_DOMAIN=meetjwt.example.com
LETSENCRYPT_EMAIL=admin@example.com
ENABLE_HTTP_REDIRECT=1
ENABLE_HSTS=1
DISABLE_HTTPS=0
ENABLE_XMPP_WEBSOCKET=1

# ---- XMPP domains ----------------------------------------------------------
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
XMPP_SERVER=xmpp.meet.jitsi
XMPP_BOSH_URL_BASE=http://xmpp.meet.jitsi:5280

# ---- Auth: JWT (MUST match Django JITSI_JWT_* settings) --------------------
ENABLE_AUTH=1
ENABLE_GUESTS=1
AUTH_TYPE=jwt
JWT_APP_ID=aurora
JWT_APP_SECRET=change-me
JWT_ACCEPTED_ISSUERS=aurora
JWT_ACCEPTED_AUDIENCES=jitsi
JWT_ALLOW_EMPTY=0
JWT_AUTH_TYPE=token

# ---- Internal component secrets (generate with: openssl rand -hex 16) ------
JICOFO_COMPONENT_SECRET=
JICOFO_AUTH_USER=focus
JICOFO_AUTH_PASSWORD=
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=
JVB_BREWERY_MUC=jvbbrewery
JICOFO_ENABLE_HEALTH_CHECKS=1
JVB_TCP_HARVESTER_DISABLED=true
JVB_STUN_SERVERS=meet-jit-si-turnrelay.jitsi.net:443

TZ=Europe/Madrid
